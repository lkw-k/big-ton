{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://doldari.local/schema/interview.schema.json",
  "title": "Interview API",
  "description": "인터뷰 API 요청·응답 (spec §4.1). 질문은 최대 5개.",
  "oneOf": [
    { "$ref": "#/$defs/createSessionRequest" },
    { "$ref": "#/$defs/createSessionResponse" },
    { "$ref": "#/$defs/answersRequest" }
  ],
  "$defs": {
    "field": {
      "description": "질문 대상 Requirements 필드. item은 사용자 입력으로 정해지므로 제외.",
      "enum": ["budget", "due_date", "need_install", "quantity", "notes"]
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "question"],
      "properties": {
        "field": { "$ref": "#/$defs/field" },
        "question": { "type": "string", "minLength": 1 }
      }
    },
    "createSessionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item"],
      "properties": {
        "item": { "type": "string", "minLength": 1 }
      }
    },
    "createSessionResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_id", "questions"],
      "properties": {
        "session_id": { "type": "string", "format": "uuid" },
        "questions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/question" }
        }
      }
    },
    "answersRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["answers"],
      "properties": {
        "answers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field", "answer"],
            "properties": {
              "field": { "$ref": "#/$defs/field" },
              "answer": {
                "description": "답하지 않으면 null. 공백만 있는 답도 미응답으로 처리된다.",
                "type": ["string", "null"]
              }
            }
          }
        }
      }
    }
  }
}
